# Shared backend configuration. Copy to .env and fill only the provider you use.
# Use MongoDB Atlas. If MONGODB_URL is missing or unreachable, main.py falls back to a local JSON file
# (storage/meetings_store.json, or /tmp on Vercel), which is for quick local demos only.
# Paste the URL on one line with no trailing spaces or quotes.
MONGODB_URL=
MONGODB_DATABASE=meeting_db
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Explicit provider: gemini, groq, or openai; blank selects the first configured key. Model selection is automatic.
MINUTES_LLM_PROVIDER=
MINUTES_LLM_MODEL=
LLM_MODEL=

MINUTES_STORAGE_MODE=mongodb
MINUTES_ENABLE_VERIFICATION=true
# Extra AI review of every claim (about 13 more calls per meeting). Off by default; the free source-quote check stays on.
# MINUTES_ENABLE_SEMANTIC_REVIEW=true
# Comma-separated browser origins allowed by CORS. https://*.shivsharan.me and Chrome extensions are always allowed.
# Production example: https://vizura-frontend.vercel.app,https://capstone-app.shivsharan.me
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000

# Automatic bounded recovery for output truncation
MINUTES_OUTPUT_TOKEN_CEILING=16384
MINUTES_LENGTH_RETRIES=2
MINUTES_CHUNK_TOKENS=2000

# Audio transcription (faster-whisper, runs locally; not available on Vercel).
# tiny/base/small/medium, or a path to a downloaded model directory.
AUDIO_WHISPER_MODEL=base

# Experiment tracking with MLflow (DagsHub). Off unless MLFLOW_TRACKING_URI is set.
# Every pipeline run is logged as one MLflow run: steps, timings, counts, tokens, cost. Transcripts and names are never sent.
# Create a token at https://dagshub.com/user/settings/tokens and keep it ONLY in .env / the Vercel environment.
# MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
# MLFLOW_TRACKING_USERNAME=<dagshub username>
# MLFLOW_TRACKING_PASSWORD=<dagshub token>
# MLFLOW_EXPERIMENT_NAME=meeting-intelligence
# MLFLOW_EVAL_EXPERIMENT=meeting-intelligence-evals
# MLFLOW_BACKGROUND=false   # true = do not make requests wait for the upload (may be cut off on serverless)
# MLFLOW_DISABLED=false

# Which AI provider to use. Leave unset and the first key found wins (Gemini, then Groq, then OpenAI).
# To switch, set LLM_PROVIDER=groq or LLM_PROVIDER=gemini (both keys may stay set). LLM_MODEL, if set, must belong to that provider.
# LLM_PROVIDER=gemini

# Local model through LM Studio (runs on your machine; the deployed site cannot reach it). Used only when you choose it:
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1     # LM Studio server address (this is the default)
# LOCAL_LLM_MODEL=qwen/qwen3-4b-instruct-2507     # the model id shown by http://127.0.0.1:1234/v1/models
# LOCAL_LLM_NO_THINK=true                         # adds /no_think for Qwen3 models (skips its slow hidden reasoning)
# MINUTES_CONTEXT_TOKENS=16384                    # match the context length you load the model with in LM Studio
# MINUTES_TOKENS_PER_MINUTE=1000000               # no cloud rate limit locally
# MINUTES_TIMEOUT_SECONDS=900                     # local models can take minutes per call
